{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/case-study-loveworld(.html)?",
      "destination": "/events.html#loveworld",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/site/$1"
    }
  ]
}
